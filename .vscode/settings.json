{
  // cpptools 和 clangd 都是 C++ 语言服务，同时开会互相抢补全/跳转/诊断，
  // 表现就是"时有时无"或干脆没提示。这里只保留 cpptools 的调试器(cppvsdbg)，
  // IntelliSense 全部交给 clangd。
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.autocomplete": "disabled",

  // WinGet 装的 clangd 是 Links 下的符号链接，指它而不是 Packages 里带版本号的
  // 真实路径，这样升级 clangd 后不用改配置。
  "clangd.path": "C:\\Users\\byqin\\AppData\\Local\\Microsoft\\WinGet\\Links\\clangd.exe",

  // 不加 --compile-commands-dir：编译数据库位置由仓库根的 .clangd 统一指定，
  // 避免两处配置漂移。
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--completion-style=detailed",
    "--header-insertion=never",
    "--pch-storage=memory"
  ],

  // 改完 .clangd 或 .clang-format 后自动重启语言服务，省得手动 Restart。
  "clangd.onConfigChanged": "restart"
}
